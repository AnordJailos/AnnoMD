diff --git a/.github/workflows/winget.yml b/.github/workflows/winget.yml
new file mode 100644
index 0000000..f87f093
--- /dev/null
+++ b/.github/workflows/winget.yml
@@ -0,0 +1,34 @@
+# Opens an update pull request on microsoft/winget-pkgs after each GitHub Release.
+#
+# INACTIVE until both are true (see RELEASING.md):
+#   1. the first AnnoMD manifest has been submitted by hand and merged into winget-pkgs
+#   2. a repository secret named WINGET_TOKEN exists (classic PAT with public_repo scope)
+name: winget
+
+on:
+  release:
+    types: [released]
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: 'Release tag to submit (e.g. v1.3.0)'
+        required: true
+
+jobs:
+  winget:
+    runs-on: windows-latest
+    env:
+      HAS_TOKEN: ${{ secrets.WINGET_TOKEN != '' }}
+    steps:
+      - name: Open update PR on microsoft/winget-pkgs
+        if: env.HAS_TOKEN == 'true'
+        uses: vedantmgoyal9/winget-releaser@v2
+        with:
+          identifier: AnordJailos.AnnoMD
+          installers-regex: '-Setup\.exe$'     # the installer only, not the portable AnnoMD.exe
+          release-tag: ${{ github.event.release.tag_name || github.event.inputs.tag }}
+          token: ${{ secrets.WINGET_TOKEN }}
+
+      - name: Skipped (no WINGET_TOKEN secret)
+        if: env.HAS_TOKEN != 'true'
+        run: echo "WINGET_TOKEN is not set - skipping. See RELEASING.md."
