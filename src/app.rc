#include <winver.h>
#include "version.h"          /* generated by the Makefile from the VERSION file */

1 ICON "assets/app.ico"
1 24 "src/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AnordJailos"
      VALUE "FileDescription", "AnnoMD - tiny Markdown reader and editor"
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "AnnoMD"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "AnnoMD.exe"
      VALUE "ProductName", "AnnoMD"
      VALUE "ProductVersion", VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
